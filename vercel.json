{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/((?!assets/|images/|audio/|products/|case-studies/|draco/|fonts/|models/|textures/|videos/|works/covers/|robots\\.txt|sitemap\\.xml|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ]
}
