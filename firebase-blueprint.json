{
  "entities": {
    "SiteSection": {
      "title": "Site Section",
      "description": "Content for individual site sections such as hero, about, contact, and social settings",
      "type": "object",
      "properties": {
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      }
    },
    "Work": {
      "title": "Work Project",
      "description": "A portfolio project item showcasing creative works",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the project"
        },
        "title": {
          "type": "string",
          "description": "Project title"
        },
        "slug": {
          "type": "string",
          "description": "URL-friendly slug"
        },
        "category": {
          "type": "string",
          "description": "Category slug or identifier"
        },
        "status": {
          "type": "string",
          "description": "Publication status: published, draft, or archived"
        },
        "year": {
          "type": "string",
          "description": "Year of creation"
        },
        "order": {
          "type": "number",
          "description": "Display sort order"
        }
      },
      "required": ["id", "title", "status"]
    },
    "Category": {
      "title": "Category",
      "description": "Portfolio project category filter",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier"
        },
        "name": {
          "type": "string",
          "description": "Category display name"
        },
        "slug": {
          "type": "string",
          "description": "URL slug"
        },
        "status": {
          "type": "string",
          "description": "Status: active or inactive"
        },
        "order": {
          "type": "number",
          "description": "Display order"
        }
      },
      "required": ["id", "name", "slug", "status"]
    },
    "MediaItem": {
      "title": "Media Item",
      "description": "Asset stored in the media library and Firebase Storage",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique asset identifier"
        },
        "name": {
          "type": "string",
          "description": "File or asset name"
        },
        "filename": {
          "type": "string",
          "description": "Filename of the media"
        },
        "originalFileName": {
          "type": "string",
          "description": "Original uploaded filename"
        },
        "mimeType": {
          "type": "string",
          "description": "MIME type"
        },
        "mediaType": {
          "type": "string",
          "description": "Media category (image, video, 3d, audio, other)"
        },
        "type": {
          "type": "string",
          "description": "Media category"
        },
        "size": {
          "type": "string",
          "description": "Formatted file size string"
        },
        "storagePath": {
          "type": "string",
          "description": "Firebase Storage path of the original file"
        },
        "url": {
          "type": "string",
          "description": "Public download URL from Firebase Storage"
        },
        "source": {
          "type": "string",
          "description": "Upload origin source (computer, google-drive, url, zip)"
        },
        "sourceFileId": {
          "type": "string",
          "description": "Remote file ID if imported from external source"
        },
        "originalPath": {
          "type": "string",
          "description": "Storage path to original asset"
        },
        "optimizedPath": {
          "type": "string",
          "description": "Storage path to optimized asset"
        },
        "optimizedUrl": {
          "type": "string",
          "description": "Public download URL for optimized web variant"
        },
        "thumbnailUrl": {
          "type": "string",
          "description": "Public download URL for thumbnail variant"
        },
        "categoryId": {
          "type": "string",
          "description": "Associated Category ID"
        },
        "workGroupId": {
          "type": "string",
          "description": "Associated WorkGroup ID"
        },
        "status": {
          "type": "string",
          "description": "Status (published, hidden, archived)"
        },
        "visibility": {
          "type": "string",
          "description": "Visibility state"
        },
        "createdAt": {
          "type": "string",
          "description": "Creation ISO timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "Last update ISO timestamp"
        }
      },
      "required": ["id", "name", "url"]
    },
    "Admin": {
      "title": "Admin",
      "description": "Administrator account metadata",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "description": "Role level"
        }
      },
      "required": ["email"]
    },
    "GuestbookEntry": {
      "title": "Guestbook Entry",
      "description": "Public guestbook message",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Author name"
        },
        "message": {
          "type": "string",
          "description": "Message content"
        },
        "createdAt": {
          "type": "string",
          "description": "Timestamp"
        }
      },
      "required": ["name", "message"]
    }
  },
  "firestore": {
    "/site/{sectionId}": {
      "schema": "SiteSection",
      "description": "Public site content sections"
    },
    "/works/{workId}": {
      "schema": "Work",
      "description": "Portfolio work items"
    },
    "/categories/{categoryId}": {
      "schema": "Category",
      "description": "Work category items"
    },
    "/media/{mediaId}": {
      "schema": "MediaItem",
      "description": "Media library assets"
    },
    "/admins/{adminId}": {
      "schema": "Admin",
      "description": "Authorized administrators"
    },
    "/guestbook/{entryId}": {
      "schema": "GuestbookEntry",
      "description": "Visitor guestbook entries"
    }
  }
}
