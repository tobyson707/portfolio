rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "tobyson707@gmail.com" ||
        request.auth.token.email == "jh204222@gmail.com"
      );
    }

    // Media library assets: public read for display on portfolio, admin write for console management
    match /media/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Audio assets
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Default fallback
    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
